# ─────────────────────────────────────────────────────────────────────────────
# .env.example — HA-MQTT-SDK environment configuration template
#
# Usage:
#   cp .env.example .env
#   # Edit .env and fill in your values
#
# IMPORTANT:
#   .env.example  → safe to commit  (no real secrets, just placeholders)
#   .env          → NEVER commit    (contains real credentials)
#
# The SDK reads these values via os.getenv() in MQTTSettings.
# ─────────────────────────────────────────────────────────────────────────────

# ── MQTT broker ───────────────────────────────────────────────────────────────

# Hostname or IP of the MQTT broker.
# Use the Docker service name when running on the same Docker network.
MQTT_HOST=localhost

# MQTT broker port.
# 1883 = unencrypted (development)
# 8883 = TLS encrypted (production)
MQTT_PORT=1883

# MQTT client identifier — must be unique per connected client.
# Leave empty to let the broker assign one automatically.
MQTT_CLIENT_ID=ha_mqtt_sdk

# MQTT broker credentials.
# Leave empty if the broker allows anonymous connections (development only).
MQTT_USER=
MQTT_PASSWORD=

# Keepalive interval in seconds.
# The client sends a PINGREQ at this interval to keep the connection alive.
MQTT_KEEPALIVE=60

# ── Home Assistant ────────────────────────────────────────────────────────────

# MQTT discovery topic prefix.
# Must match the discovery prefix configured in Home Assistant.
# Only change this if you changed the default in HA settings.
DISCOVERY_PREFIX=homeassistant

# ── Logging ───────────────────────────────────────────────────────────────────

# Python logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Use DEBUG during development, INFO in production.
LOG_LEVEL=INFO

# ── Reconnection ─────────────────────────────────────────────────────────────

# Whether to attempt reconnection when the broker connection is lost.
# Values: true, false
RECONNECT=true

# Initial reconnect delay in seconds (minimum: 0.1).
# Delay doubles on each failed attempt (exponential backoff).
RECONNECT_DELAY_MIN=1.0

# Maximum reconnect delay cap in seconds.
# Must be >= RECONNECT_DELAY_MIN.
RECONNECT_DELAY_MAX=60.0
